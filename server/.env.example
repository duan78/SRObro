# ============================================
# SRObro Server Environment Configuration
# ============================================

# Environment
NODE_ENV=development

# Server
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL with Connection Pooling)
DATABASE_URL=postgresql://srobro:srobro123@localhost:5432/srobro?connection_limit=20&pool_timeout=30&connect_timeout=10

# Redis (Cache + Socket.IO Adapter + Sessions)
REDIS_URL=redis://:srobro123@localhost:6379
REDIS_PASSWORD=srobro123
REDIS_HOST=localhost
REDIS_PORT=6379

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string-in-production
JWT_EXPIRATION=7d
SESSION_SECRET=change-this-to-another-secure-random-string
SESSION_MAX_AGE=604800000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Game Settings
TICK_RATE=20
MAX_PLAYERS=100
MAX_PLAYERS_PER_SERVER=100
AOI_RADIUS=100

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000
SOCKET_IO_PING_TIMEOUT=30000
SOCKET_IO_PING_INTERVAL=25000
SOCKET_IO_MAX_HTTP_BUFFER_SIZE=1e6

# Redis Adapter Configuration (for horizontal scaling)
REDIS_ADAPTER_KEY=srobro
REDIS_ADAPTER_PUBLISH_ON_CLIENT_ERROR=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Security
BCRYPT_ROUNDS=10
 helmet_max_Age=15768000

# Monitoring (optional)
# ENABLE_PROMETHEUS=true
# PROMETHEUS_PORT=9090
